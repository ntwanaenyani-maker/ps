# MongoDB Atlas connection string (Option A) or a local mongod (Option B).
# If unset, the API falls back to the in-memory store so it still boots.
MONGODB_URI=

# Optional. Enables hosted card checkout at /api/pay/initialize.
PAYSTACK_SECRET_KEY=

# PayPal REST app credentials. Enables Card & PayPal checkout via
# /api/pay/paypal/create and /api/pay/paypal/capture.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" (default) or "live".
PAYPAL_ENV=sandbox
# PayPal does not support ZAR, so store orders are charged in this currency.
PAYPAL_SETTLE_CURRENCY=USD
# Number of ZAR equal to 1 USD (used to convert store prices for PayPal).
PAYPAL_ZAR_PER_USD=18.5
# PayPal webhook id (Developer Dashboard -> your app -> Webhooks). Verifies the
# signature of events sent to POST /api/webhooks/paypal.
PAYPAL_WEBHOOK_ID=

# Stitch (Pay by Bank) credentials. Enables /api/pay/stitch/create,
# /api/pay/stitch/confirm and /api/pay/stitch/simulate. The client must have the
# client_paymentrequest scope enabled.
STITCH_CLIENT_ID=
STITCH_CLIENT_SECRET=
# "test" (default) or "live". Simulation is only allowed in test mode.
STITCH_ENV=test
# Where Stitch redirects the payer after completing/cancelling. Must be an
# allowlisted origin on the Stitch client (defaults to the first CORS_ORIGIN
# entry + /?stitch=return).
STITCH_REDIRECT_URI=

# Brevo (transactional email). Enables order confirmation / paid receipts and
# the password-reset & email-verification one-time codes. If BREVO_API_KEY or
# BREVO_SENDER_EMAIL is unset, emails are skipped silently.
BREVO_API_KEY=
# Must be a verified sender in your Brevo account.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Phethagatsa Solutions
# Where new-order notifications are sent (defaults to BREVO_SENDER_EMAIL).
ADMIN_EMAIL=
# Secret used to hash one-time codes. Use a long random string in production.
OTP_SECRET=

# Google OAuth web client ID. Enables "Sign in with Google" at /api/auth/google.
GOOGLE_CLIENT_ID=

# Store configuration
WHATSAPP_NUMBER=27723819402
DEFAULT_CURRENCY=ZAR
FREE_SHIPPING_THRESHOLD=450
APP_NAME=Phethagatsa Solutions

# Comma-separated list of allowed browser origins for CORS.
# Use * to allow all, or e.g. https://phethagatsa-solutions.onrender.com
CORS_ORIGIN=*

PORT=3001
NODE_ENV=production
