# MongoDB Atlas connection string (Option A) or a local mongod (Option B).
# If unset, the API falls back to the in-memory store so it still boots.
MONGODB_URI=

# Optional. Enables hosted card checkout at /api/pay/initialize.
PAYSTACK_SECRET_KEY=

# Google OAuth web client ID. Enables "Sign in with Google" at /api/auth/google.
GOOGLE_CLIENT_ID=

# Store configuration
WHATSAPP_NUMBER=27723819402
DEFAULT_CURRENCY=ZAR
FREE_SHIPPING_THRESHOLD=450
APP_NAME=Phethagatsa Solutions

# Comma-separated list of allowed browser origins for CORS.
# Use * to allow all, or e.g. https://phethagatsa-solutions.onrender.com
CORS_ORIGIN=*

PORT=3001
NODE_ENV=production
