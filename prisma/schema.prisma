// Prisma Schema for Phethagatsa Solutions Modern African Skincare
// Supports MongoDB Atlas Free Tier

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

// Google AI / Gemini Configuration
// apiKey is set via environment: al-e9HeVjsPH6ZOrnjGVZ8dStW6chZ-IYO3AOtUV9-PCxF

model User {
  id               String           @id @default(uuid())
  email            String           @unique
  passwordHash     String?
  name             String
  phone            String?
  role             Role             @default(CUSTOMER)
  memberTier       MemberTier       @default(BRONZE)
  loyaltyPoints    Int              @default(50)
  totalOrdersCount Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  addresses        Address[]
  orders           Order[]
  reviews          Review[]
  wishlist         WishlistItem[]

  @@map("users")
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDefault  Boolean  @default(false)
  fullName   String
  phone      String
  street     String
  city       String
  province   String   // Gauteng, Western Cape, KwaZulu-Natal, etc.
  postalCode String
  country    String   @default("South Africa")
  createdAt  DateTime @default(now())

  @@map("addresses")
}

model Category {
  id          String    @id @default(uuid())
  slug        String    @unique // face-care, body-care, hair-care, bundles, supplements, exfoliator
  name        String
  description String?
  imageUrl    String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())

  @@map("categories")
}

model Product {
  id             String           @id @default(uuid())
  handle         String           @unique
  name           String
  tagline        String
  categoryId     String
  category       Category         @relation(fields: [categoryId], references: [id])
  vendor         String           @default("Phethagatsa Solutions")
  type           String           // Moisturizer, Serum, Cleanser, Balm, Superfood, etc.
  tags           String[]
  sku            String           @unique
  grams          Int              @default(100)
  priceZAR       Decimal          @db.Decimal(10, 2)
  originalPrice  Decimal?         @db.Decimal(10, 2)
  image          String
  images         String[]
  description    String
  bodyHtml       String?
  howToUse       String?
  ingredients    String?
  benefits       String[]
  stock          Int              @default(100)
  rating         Float            @default(5.0)
  reviewCount    Int              @default(0)
  featured       Boolean          @default(false)
  variants       ProductVariant[]
  reviews        Review[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("products")
}

model ProductVariant {
  id         String      @id @default(uuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String      // e.g. "50ml Glass Jar", "100ml Value Jar"
  size       String?
  sku        String      @unique
  priceZAR   Decimal     @db.Decimal(10, 2)
  grams      Int?
  stock      Int         @default(50)
  inStock    Boolean     @default(true)
  orderItems OrderItem[]

  @@map("product_variants")
}

model Order {
  id                String         @id @default(uuid())
  orderNumber       String         @unique // e.g. PS2437
  userId            String?
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String
  customerPhone     String
  shippingAddress   String
  city              String
  province          String
  postalCode        String
  subtotal          Decimal        @db.Decimal(10, 2)
  shippingCost      Decimal        @db.Decimal(10, 2) @default(0.00)
  discount          Decimal        @db.Decimal(10, 2) @default(0.00)
  total             Decimal        @db.Decimal(10, 2)
  currency          String         @default("ZAR")
  paymentMethod     PaymentMethod  @default(INSTANT_EFT)
  status            OrderStatus    @default(PENDING)
  notes             String?
  whatsappSent      Boolean        @default(false)
  trackingNumber    String?        // e.g. TCG-78921 (The Courier Guy)
  items             OrderItem[]
  timelineEvents    OrderEvent[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("orders")
}

model OrderItem {
  id         String          @id @default(uuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String
  product    Product         @relation(fields: [productId], references: [id])
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  unitPrice  Decimal         @db.Decimal(10, 2)
  quantity   Int             @default(1)
  totalPrice Decimal         @db.Decimal(10, 2)

  @@map("order_items")
}

model OrderEvent {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title       String   // Order Placed, Processing, Shipped, Delivered
  description String
  completed   Boolean  @default(false)
  timestamp   DateTime @default(now())

  @@map("order_events")
}

model Review {
  id               String   @id @default(uuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorName       String
  authorLocation   String?  // e.g. Pretoria, Cape Town, Johannesburg
  rating           Int      // 1 to 5
  headline         String?
  comment          String
  verifiedPurchase Boolean  @default(true)
  helpfulCount     Int      @default(0)
  createdAt        DateTime @default(now())

  @@map("reviews")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model StoreSetting {
  id                    String   @id @default(uuid())
  storeName             String   @default("Phethagatsa Solutions")
  storeEmail            String   @default("care@phethagatsa.co.za")
  storePhone            String   @default("+27 (0)11 832 9400")
  whatsappNumber        String   @default("27723819402")
  storeAddress          String   @default("123 Main Street, Pretoria / Johannesburg, Gauteng, 0001")
  currency              String   @default("ZAR")
  defaultShipping       Decimal  @default(75.00) @db.Decimal(10, 2)
  freeShippingThreshold Decimal  @default(450.00) @db.Decimal(10, 2)
  updatedAt             DateTime @updatedAt

  @@map("store_settings")
}
