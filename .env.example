# ---------------------------------------------------------------------------
# Phethagatsa Solutions - environment variables
# Copy to `.env` (backend) / `.env.local` (frontend). NEVER commit real values.
# ---------------------------------------------------------------------------

# Backend (server/.env)
# MongoDB connection string. If unset, the API falls back to an in-memory store
# (data resets on restart) so it still boots for previews.
MONGODB_URI=""
# Optional: admin key required by POST/PUT/DELETE /api/products (X-API-Key header).
ADMIN_API_KEY="change-me"
# Optional: comma-separated allowed origins, or * (default *).
CORS_ORIGIN="*"
# Optional: enables card checkout on POST /api/pay/initialize.
PAYSTACK_SECRET_KEY=""
# PayPal REST app credentials (sandbox or live) for Card & PayPal checkout.
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# "sandbox" (default) or "live".
PAYPAL_ENV="sandbox"
# Stitch (Pay by Bank) credentials. Enables /api/pay/stitch/*. The client must
# have the client_paymentrequest scope. Test or live Client ID + Secret.
STITCH_CLIENT_ID=""
STITCH_CLIENT_SECRET=""
# "test" (default) or "live". Controls whether /api/pay/stitch/simulate is allowed.
STITCH_ENV="test"
# Where Stitch redirects the payer after they finish. Must be an allowlisted
# https origin/path (defaults to the first CORS_ORIGIN entry + /?stitch=return).
STITCH_REDIRECT_URI=""
# Brevo (transactional email). Enables order confirmations, paid receipts and
# the password-reset / email-verification one-time codes.
BREVO_API_KEY=""
# Verified sender address and display name in Brevo.
BREVO_SENDER_EMAIL=""
BREVO_SENDER_NAME="Phethagatsa Solutions"
# Where new-order notifications are sent (defaults to BREVO_SENDER_EMAIL).
ADMIN_EMAIL=""
# Secret used to hash one-time codes (change to a long random string).
OTP_SECRET=""

# Google OAuth web client ID used by POST /api/auth/google to verify ID tokens.
GOOGLE_CLIENT_ID=""
# WhatsApp concierge number used by POST /api/whatsapp/order-link.
WHATSAPP_NUMBER="27723819402"

# Frontend (.env.local) - base URL of the API. Leave blank for same-origin/local proxy.
VITE_API_URL=""
# Frontend: Google OAuth web client ID shown on the sign-in modal (public value).
VITE_GOOGLE_CLIENT_ID=""
# Frontend: PayPal public client ID used to render the Card & PayPal buttons.
VITE_PAYPAL_CLIENT_ID=""
VITE_WHATSAPP_NUMBER="27723819402"
